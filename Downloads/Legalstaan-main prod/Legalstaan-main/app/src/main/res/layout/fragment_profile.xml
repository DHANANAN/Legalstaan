<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Profile header card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorSurface"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/circle_avatar_bg"
                android:contentDescription="Avatar"
                android:padding="16dp"
                android:src="@drawable/ic_nav_profile"
                android:tint="#9E9E9E" />

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_name"
                android:textColor="@color/colorBodyText"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_profile_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorSecondaryText"
                android:textSize="13sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@color/colorBackground" />

        <!-- Menu rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorSurface"
            android:orientation="vertical">

            <include layout="@layout/item_profile_row" android:id="@+id/row_certificates" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/colorDivider" />
            <include layout="@layout/item_profile_row" android:id="@+id/row_downloads" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/colorDivider" />
            <include layout="@layout/item_profile_row" android:id="@+id/row_free_material" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/colorDivider" />
            <include layout="@layout/item_profile_row" android:id="@+id/row_settings" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/colorDivider" />

            <!-- Dark mode toggle row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dark Mode"
                    android:textColor="@color/colorBodyText"
                    android:textSize="15sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/colorDivider" />
            <include layout="@layout/item_profile_row" android:id="@+id/row_how_to" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/colorDivider" />
            <include layout="@layout/item_profile_row" android:id="@+id/row_privacy" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/colorDivider" />
            <include layout="@layout/item_profile_row" android:id="@+id/row_sign_out" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:background="@color/colorBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="© 2024 Legalstaan · MIT License"
            android:textSize="11sp"
            android:textColor="@color/colorSecondaryText"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
